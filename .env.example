# ===== CINEMA BOOKING SYSTEM ENVIRONMENT CONFIGURATION =====
# Sao chép file này thành .env và điền các giá trị phù hợp với máy của bạn.
# File .env chứa thông tin bí mật và KHÔNG ĐƯỢC COMMIT lên GitHub!

# Database connection URL (MySQL 8.4)
DATABASE_URL="mysql://cbs:cbs_password@localhost:3306/cinema_booking"
SHADOW_DATABASE_URL="mysql://root:root@localhost:3306/cinema_booking_shadow"

# Server Port
PORT=3000

# JWT Authentication Config
# Thay đổi secret key này bằng một chuỗi ngẫu nhiên, bảo mật trên môi trường của bạn:
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="1h"

# VNPAY Sandbox (do not commit real secrets)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/api/payments/vnpay/return"
# Đăng ký URL public này trong cấu hình merchant VNPAY; VNPAY không gọi được localhost.
VNPAY_IPN_URL="https://your-public-api.example.com/api/payments/vnpay/ipn"
CLIENT_PAYMENT_RESULT_URL=""