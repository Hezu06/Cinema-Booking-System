# Local npm development environment.
# Docker Compose overrides DATABASE_URL with the internal hostname "mysql".

# ===== NODE ENVIRONMENT =====
NODE_ENV=development

# ===== SERVER CONFIGURATION =====
PORT=3000
HOST=localhost

# ===== DATABASE CONFIGURATION =====
DATABASE_URL=mysql://cbs:cbs_password@localhost:3306/cinema_booking

# ===== JWT CONFIGURATION =====
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ===== CORS CONFIGURATION =====
CORS_ORIGIN=http://localhost:3000

# ===== LOGGING =====
LOG_LEVEL=info
